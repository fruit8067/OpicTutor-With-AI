DATABASE_URL=postgresql://opic:opic@127.0.0.1:5432/opic
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=../data
TTS_DIR=static/tts
RAG_BUILD_DIR=../rag_docs/build
EVAL_SYSTEM_PROMPT_PATH=../docs/prompts/opic_evaluation_system.md
# Pickle: 사용자 실습 기준. 키는 파일에만 저장하고 커밋하지 마세요.
LLM_BASE_URL=https://llm.pcl.kr/v1
# os.getenv: LLM_API_KEY가 비어 있으면 PICKLE_API_KEY 사용
LLM_API_KEY=
PICKLE_API_KEY=
LLM_MODEL=pickle-general
LLM_TIMEOUT_SEC=90
# 검색 임베딩 키는 Pickle 키와 별도로 설정. 기존 DB는 init_db 전진 마이그레이션 후 재적재.
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WORKER_ID=
WORKER_JOB_TYPES=tts_prepare,stt,evaluate
LOG_LEVEL=INFO
