DATABASE_URL=postgresql://opic:opic@127.0.0.1:5432/opic
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=../data
TTS_DIR=static/tts
RAG_BUILD_DIR=../rag_docs/build
EVAL_SYSTEM_PROMPT_PATH=../docs/prompts/opic_evaluation_system.md
# Pickle: 실제 OpenAI 호환 API base URL 및 정확한 모델 ID를 입력
LLM_BASE_URL=
# LLM 인증 키는 os.getenv("LLM_API_KEY")로 읽음
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SEC=90
# 검색 임베딩은 기존 OpenAI 설정 유지. LLM 키와 별도로 설정
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WORKER_ID=
WORKER_JOB_TYPES=tts_prepare,stt,evaluate
LOG_LEVEL=INFO
